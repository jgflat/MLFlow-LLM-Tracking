    "MLFLOW_URI = \"http://127.0.0.1:5000\"\n",
    "\n",
    "mlflow.set_tracking_uri(MLFLOW_URI)\n",
    "\n",
    "mlflow.set_experiment(\"GenAI_MLflow_Assignment\")\n",
    "\n",
    "print(\"MLflow Connected\")"
   ]
