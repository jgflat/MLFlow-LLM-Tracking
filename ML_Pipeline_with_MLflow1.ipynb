    "\n",
    "mlflow.autolog()\n",
    "\n",
    "with mlflow.start_run():\n",
    "    \n",
    "    conversation = [\n",
    "        {\"role\": \"system\", \"content\": \"You are a helpful assistant.\"}\n",
    "    ]\n",
    "    \n",
    "    # Ask 3 user questions\n",
    "    for i in range(3):\n",
    "        user_input = input(Fore.GREEN + \"Enter your question: \" + Style.RESET_ALL)\n",
    "        print(Fore.GREEN + \"User:\", user_input, Style.RESET_ALL)\n",
    "        \n",
    "        # Add user input to conversation\n",
    "        conversation.append({\n",
    "            \"role\": \"user\",\n",
    "            \"content\": user_input\n",
    "        })\n",
    "        \n",
    "        # Generate AI response and log metrics\n",
    "        ai_response = generate_response(conversation)\n",
    "        \n",
    "        # Print AI response\n",
    "        print(Fore.BLUE + \"AI:\", ai_response, Style.RESET_ALL)\n",
    "        \n",
    "        # Add AI response to conversation\n",
    "        conversation.append({\n",
    "            \"role\": \"assistant\",\n",
    "            \"content\": ai_response\n",
    "        })"
   ]
